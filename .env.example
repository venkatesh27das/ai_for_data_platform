# Backend
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./data/assistant.db
FRONTEND_ORIGIN=http://localhost:5173
DATA_DIR=./data
MAX_UPLOAD_MB=25
LOG_LEVEL=INFO

# Default local providers
LLM_PROVIDER=lm_studio
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=gemma-4-12b-qat
EMBEDDING_PROVIDER=lm_studio
EMBEDDING_MODEL=nomic-embed-text
LLM_TEMPERATURE=0.2
LLM_REQUEST_TIMEOUT=120
# Maximum time for each specialist's structured call before its safe fallback runs.
AGENT_REQUEST_TIMEOUT=45
WORKFLOW_CHECKPOINT_PATH=./data/workflow_checkpoints.db
TOOL_REQUEST_TIMEOUT=30
MCP_REQUEST_TIMEOUT=30
# Example: {"catalog":"http://127.0.0.1:9000/mcp"}
MCP_SERVERS_JSON={}
# Fully qualified names, for example: mcp.catalog.list_tables,mcp.catalog.describe_table
MCP_TOOL_ALLOWLIST=

# Optional providers
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=

# Frontend
VITE_API_URL=http://127.0.0.1:8000/api
