# Backend
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./data/assistant.db
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
DATA_DIR=./data
MAX_UPLOAD_MB=25
LOG_LEVEL=INFO

# Default local providers
LLM_PROVIDER=lm_studio
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=gemma-4-12b-qat
EMBEDDING_PROVIDER=lm_studio
EMBEDDING_MODEL=nomic-embed-text
LLM_TEMPERATURE=0.2
LLM_REQUEST_TIMEOUT=120
# Maximum time for each specialist's structured call before its safe fallback runs.
AGENT_REQUEST_TIMEOUT=45
WORKFLOW_CHECKPOINT_PATH=./data/workflow_checkpoints.db
TOOL_REQUEST_TIMEOUT=30
MCP_REQUEST_TIMEOUT=30
MCP_SCHEMA_CACHE_TTL_SECONDS=300
# Example: {"catalog":"http://127.0.0.1:9000/mcp"}
MCP_SERVERS_JSON={}
# Fully qualified names, for example: mcp.catalog.list_tables,mcp.catalog.describe_table
MCP_TOOL_ALLOWLIST=

# Performance and resilience
LLM_MAX_CONCURRENCY=2
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_RESET_SECONDS=20
HTTP_MAX_CONNECTIONS=20
HTTP_MAX_KEEPALIVE_CONNECTIONS=10
WORKFLOW_EVENT_POLL_INTERVAL=0.15
WORKFLOW_RECENT_MESSAGE_LIMIT=12
WORKFLOW_MESSAGE_CHAR_LIMIT=4000
WORKFLOW_SOURCE_EXCERPT_LIMIT=8000
PLANNER_FAST_PATH=true
PRESENTER_FAST_PATH=true
DETERMINISTIC_SOURCE_ANALYSIS=true
DETERMINISTIC_STRUCTURAL_VALIDATION=true
AGENT_RESULT_CACHE_ENABLED=true
AGENT_RESULT_CACHE_TTL_SECONDS=86400
MEMORY_ENABLED=true
MEMORY_RETRIEVAL_LIMIT=5
MEMORY_EMBEDDING_TIMEOUT=10

# Optional providers
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=

# Frontend
VITE_API_URL=http://127.0.0.1:8000/api
# Initial display name until this browser saves its own User profile.
VITE_USER_NAME=Local User
