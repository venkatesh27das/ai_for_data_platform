{
  "profile_key": "contract_v1",
  "version": "1.0.0",
  "name": "Contract",
  "description": "Core commercial contract terms, parties, dates, amounts, and obligations.",
  "supported_document_classes": ["contract", "agreement", "order_form"],
  "fields": [
    {"name": "agreement_title", "field_type": "string", "required": true, "description": "Title of the agreement"},
    {"name": "effective_date", "field_type": "date", "required": false, "description": "Date the agreement becomes effective"},
    {"name": "termination_date", "field_type": "date", "required": false, "description": "Date the agreement terminates"},
    {"name": "governing_law", "field_type": "string", "required": false, "description": "Named governing jurisdiction"}
  ],
  "entities": [
    {"entity_type": "Organization", "description": "A contracting organization", "required_attributes": []},
    {"entity_type": "Person", "description": "A named signatory or contact", "required_attributes": []},
    {"entity_type": "Amount", "description": "A contractual monetary amount", "required_attributes": ["currency"]}
  ],
  "relationships": [
    {
      "relationship_type": "PARTY_TO",
      "source_entity_types": ["Organization", "Person"],
      "target_entity_types": ["Document"],
      "description": "Identifies a party to the contract",
      "minimum_confidence": 0.8
    },
    {
      "relationship_type": "OBLIGATED_TO",
      "source_entity_types": ["Organization", "Person"],
      "target_entity_types": ["Organization", "Person"],
      "description": "Connects an obligated party to a beneficiary",
      "minimum_confidence": 0.8
    }
  ],
  "typed_output_tables": [
    {
      "table_name": "contract_terms",
      "description": "One row of normalized high-value contract terms",
      "fields": [
        {"name": "agreement_title", "field_type": "string", "required": true, "description": "Agreement title"},
        {"name": "effective_date", "field_type": "date", "required": false, "description": "Effective date"},
        {"name": "termination_date", "field_type": "date", "required": false, "description": "Termination date"},
        {"name": "governing_law", "field_type": "string", "required": false, "description": "Governing law"}
      ]
    }
  ],
  "validation_rules": {"require_evidence": true, "require_party": true},
  "minimum_confidence": 0.7
}
